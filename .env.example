# Server
PORT=3000
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://localhost:8088

# OpenBao Agent proxy (l'Agent gira sulla macchina host e gestisce auth + token renewal)
# In produzione: OPENBAO_ADDR punta all'Agent sulla macchina host (http://host-gateway:8200)
# In development: puoi puntare direttamente a OpenBao con OPENBAO_AGENT_MODE=false
OPENBAO_AGENT_MODE=true
OPENBAO_ADDR=http://host-gateway:8200

# Webhook verso la Main App
MAIN_APP_WEBHOOK_URL=http://localhost:8000/api/webhooks/whatsapp

# BullBoard Admin Dashboard (opzionale)
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=

# Encryption (AES-256) - Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
